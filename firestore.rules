rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Agent configurations and public widget settings are accessed through trusted API routes.
    match /agents/{agentId} { allow read, write: if false; }
    match /agent_info/{agentId} { allow read, write: if false; }
    match /public_agents/{agentId} { allow read, write: if false; }
    match /private_agents/{agentId} { allow read, write: if false; }
    match /deleted_agents/{agentId} { allow read, write: if false; }
    match /settings/{settingId} { allow read, write: if false; }

    match /conversations/{conversationId} {
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
    }
    match /user_info/{visitorId} {
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
